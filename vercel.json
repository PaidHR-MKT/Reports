{
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.paidhr.com/reports-research",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "https://www.paidhr.com/reports-research",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|gif|webp|ico|json)",
      "destination": "/$1.$2"
    },

    {
      "source": "/:folder/:page.html",
      "destination": "/:folder/:page"
    },
    {
      "source": "/:slug.html",
      "destination": "/:slug"
    },

    {
      "source": "/:folder/:page/",
      "destination": "/:folder/:page"
    },
    {
      "source": "/:slug/",
      "destination": "/:slug"
    },

    {
      "source": "/:folder/:page",
      "destination": "/:folder/:page.html"
    },
    {
      "source": "/:slug",
      "destination": "/:slug.html"
    },

    {
      "source": "/:folder",
      "destination": "/:folder/index.html"
    }
  ]
}
